<style>
    .category-strip {
        border-bottom: 0.5px solid #E5E1D8;
        background: #FBFAF7;
        font-family: Georgia, 'Times New Roman', serif;
    }

    .category-strip__list {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 1rem 3.375rem;
        padding: 2rem 1.5rem;
        margin: 0;
        list-style: none;
    }

    .category-strip__item {
        text-align: center;
    }

    .category-strip__link {
        display: inline-block;
        font-size: 1.125rem;
        /* 1.5x the previous 0.75rem */
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #4A473E;
        text-decoration: none;
        white-space: nowrap;
        transition: color 0.2s ease;
    }

    .category-strip__link:hover {
        color: #E561A1;
    }

    /* Tablet: slightly tighter spacing, still one centered row that wraps if needed */
    @media (max-width: 900px) {
        .category-strip__list {
            gap: 0.875rem 2.25rem;
            padding: 1.75rem 1.25rem;
        }

        .category-strip__link {
            font-size: 1.0625rem;
        }
    }

    /* Mobile: centered 2x2 grid so nothing is pushed to the left or cut off */
    @media (max-width: 600px) {
        .category-strip__list {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            justify-items: center;
            gap: 1.25rem 1rem;
            padding: 1.5rem 1rem;
        }

        .category-strip__link {
            font-size: 0.95rem;
            letter-spacing: 0.08em;
        }
    }
</style>

<div class="category-strip">
    <ul class="category-strip__list">
        <li class="category-strip__item">
            <a class="category-strip__link" href="/collections/purses-collection">Purses</a>
        </li>
        <li class="category-strip__item">
            <a class="category-strip__link" href="/collections/card-holder-collection">Card Holders</a>
        </li>
        <li class="category-strip__item">
            <a class="category-strip__link" href="/collections/mini-bag-collection">Mini Bags</a>
        </li>
        <li class="category-strip__item">
            <a class="category-strip__link" href="/collections/keychain-collection">Keychains</a>
        </li>
    </ul>
</div>

{% schema %}
