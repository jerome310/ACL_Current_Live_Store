<style>
    .featured-pieces {
        padding: 2.25rem 2rem 3rem;
        text-align: center;
        font-family: Georgia, 'Times New Roman', serif;
        background: #FBFAF7;
    }

    .featured-pieces__eyebrow {
        font-size: 0.7rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: #8A8578;
        margin: 0 0 6px;
    }

    .featured-pieces__heading {
        font-size: 1.25rem;
        font-style: italic;
        font-weight: 400;
        color: #1A1A18;
        margin: 0 0 1.75rem;
    }

    .featured-pieces__grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.25rem;
        max-width: 1100px;
        margin: 0 auto;
    }

    @media (max-width: 700px) {
        .featured-pieces__grid {
            grid-template-columns: 1fr;
            max-width: 380px;
        }
    }

    .featured-piece {
        text-decoration: none;
        display: block;
    }

    .featured-piece__image-wrap {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1;
        background: #EDE7D8;
        border-radius: 2px;
        overflow: hidden;
    }

    .featured-piece__image-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .featured-piece__sold-out {
        position: absolute;
        top: 10px;
        left: 10px;
        background: #1A1A18;
        color: #fff;
        font-size: 0.65rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 2px;
    }

    .featured-piece__title {
        font-size: 0.7rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #8A8578;
        margin: 10px 0 2px;
    }

    .featured-piece__price {
        font-size: 0.8rem;
        color: #1A1A18;
        margin: 0;
    }

    .featured-piece__price--sale {
        color: #B23A3A;
    }

    .featured-piece__compare-price {
        color: #8A8578;
        text-decoration: line-through;
        margin-right: 6px;
        font-size: 0.75rem;
    }
</style>

<div class="featured-pieces">
    <p class="featured-pieces__eyebrow">The Collection</p>
    <p class="featured-pieces__heading">Featured pieces</p>

    {% assign featured_handles =
    "smiley-cereal-tote-bags-☺️|berry-strawberry-wallet|strawberry-joy-card-holder-wallet-red-tan🍓🍓" | split: "|" %}

    <div class="featured-pieces__grid">
        {% for handle in featured_handles %}
        {% assign product = all_products[handle] %}

        <a href="{% if product %}{{ product.url }}{% else %}#{% endif %}" class="featured-piece">
            <div class="featured-piece__image-wrap">
                {% if product and product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | default: product.title }}" loading="lazy">
                {% else %}
                <img src="{{ 'placeholder-product.jpg' | asset_url }}"
                    alt="Product not found — check the handle in featured-pieces.liquid" loading="lazy">
                {% endif %}

                {% if product and product.available == false %}
                <span class="featured-piece__sold-out">Sold Out</span>
                {% endif %}
            </div>

            <p class="featured-piece__title">
                {{ product.title | default: "Product not found" }}
            </p>

            {% if product %}
            <p
                class="featured-piece__price {% if product.compare_at_price > product.price %}featured-piece__price--sale{% endif %}">
                {% if product.compare_at_price > product.price %}
                <span class="featured-piece__compare-price">{{ product.compare_at_price | money }}</span>
                {% endif %}
                {{ product.price | money }}
            </p>
            {% endif %}
        </a>
        {% endfor %}
    </div>
</div>

{% schema %}
{
"name": "Featured Pieces",
"settings": [],
"presets": [
{
"name": "Featured Pieces"
}
]
}
{% endschema %}